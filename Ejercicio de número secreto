#include<iostream>
using namespace std;
int main(){
	int numerosecreto = 10;
	int intentos;
	int cantidaddeintentos = 0;
	do {
		cout << "Intento: ";
		cin >> intentos;
		cantidaddeintentos ++;
		if (intentos > numerosecreto) {
			cout << "Es menor" << endl;
		} else if (intentos < numerosecreto) {
			cout << "Es mayor" << endl;
		}
	} while (intentos != numerosecreto);
	cout << "Correcto, lo lograste en " << cantidaddeintentos << " intentos. " << endl;
	return 0;
}
