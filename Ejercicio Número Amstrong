#include<iostream>
#include<string>
using namespace std;
int main(){
    int n;
    cin>> n;
    int a = n/100;
    int b = (n/10)%10;
    int c = n % 10;
    if ((a*a*a) + (b*b*b) + (c*c*c) == n) {
        cout << "Es amstrong" << endl;
    } else {
        cout << "No es amstrong" << endl;
    }
    return 0;
}
