#include<iostream>
using namespace std;
int main(){
    int n;
    cin >> n;
    bool esprimo = true;
    for (int i = 2; i *i <= n; i++) {
        if (n % i == 0) {
            esprimo = false;
        }
    }
    if (esprimo) {
        cout << "Es primo" << endl;
    } else {
        cout << "No es primo" << endl;
    }
    return 0;

}
